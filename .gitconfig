[core]
	excludesFile = ~/.gitignore
	editor = nvim
[rebase]
	autosquash = true
[fetch]
	prune = true
[status]
	submoduleSummary = true
[pull]
	rebase = true
[pack]
	windowMemory = 1g
	threads = 8
[http]
	postBuffer = 157286400
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/
[maintenance]
	repo = /Users/ashvin/workspace/gitlab-org/gdk
	repo = /Users/ashvin/workspace/gitlab-org/gdk/gitlab
[safe]
	directory = /Users/ashvin/workspace/gitlab-com/content-sites/handbook
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
	path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@gitlab-personal:*/**"]
	path = ~/.gitconfig-personal
