# Secrets and credentials — never commit these
.ssh/
.aws/
.kube/
.gnupg/
.docker/config.json
.gitlab-agent-token*
.gitlab-token*
.gitlab-mcp-token.json
.gitlab-license
.mcp-auth
.tsh/
.claude.json
.claude.json.tmp*

# Shell history
.zsh_history
.bash_history
.psql_history
.irb_history
.guard_history
.lesshst
.wget-hsts

# macOS
.DS_Store
.CFUserTextEncoding

# Runtime / managed by installers — not for stow
.oh-my-zsh/
.asdf/
.cargo/
.rustup/
.bun/
.gem/
.gradle/
.npm/
.yarn/
.cache/
.local/share/
.local/state/

# IDE / editor state
.viminfo
.idea/
.ijwb/
.vscode/
.cursor/
.codeium/
.windsurf/

# Misc runtime state
.zcompdump*
.zsh_sessions/
.Trash/
.DS_Store

# Claude — runtime and context state (path-specific to avoid blocking other todos/, tasks/, etc.)
.claude/history.jsonl
.claude/sessions/
.claude/cache/
.claude/telemetry/
.claude/todos/
.claude/tasks/
.claude/plans/
.claude/retro/
.claude/debug/
.claude/backups/
.claude/downloads/
.claude/paste-cache/
.claude/shell-snapshots/
.claude/file-history/
.claude/session-env/
.claude/statsig/
.claude/stats-cache.json
.claude/policy-limits.json
.claude/agents.tar.gz
.claude/settings.local.json
# Claude plugins — track manifest, not installed binaries
.claude/plugins/cache/
.claude/plugins/data/
.claude/plugins/marketplaces/
.claude/plugins/known_marketplaces.json

# Karabiner — skip auto-generated backups
.config/karabiner/automatic_backups/

# Raycast — extensions are store-installed binaries, ai/ is empty
.config/raycast/

# opencode — runtime deps
.config/opencode/node_modules/
.config/opencode/bun.lock

# Claude skill runtime deps
.claude/skills/pretty-mermaid/node_modules/
